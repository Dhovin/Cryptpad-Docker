# Auto detect text files and perform LF normalization
* text=auto

# Ensure shell scripts always use LF (POSIX) line endings
*.sh text eol=lf
*.bash text eol=lf

# Configuration and workflows
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
VERSION text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
