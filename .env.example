# ==============================================================================
# CryptPad Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env or configure these variables directly in Portainer:
# ==============================================================================

# CryptPad Release Version (Pinned from VERSION file)
CPAD_VERSION=2026.5.1

# Domain Configuration
CPAD_MAIN_DOMAIN=pad.dhovin.me
CPAD_SANDBOX_DOMAIN=pad-sandbox.dhovin.me

# Host Port Mapping (Changed from 3000 to avoid conflicts on host)
CPAD_HTTP_PORT=3010
CPAD_WEBSOCKET_PORT=3013
CPAD_HTTP_ADDRESS=0.0.0.0

# Automatically Install and Update CryptPad-vetted OnlyOffice Builds
CPAD_INSTALL_ONLYOFFICE=true

# Timezone
TZ=UTC

# Admin Contact Email
CPAD_ADMIN_EMAIL=admin@dhovin.me
