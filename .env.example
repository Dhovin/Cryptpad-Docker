# ==============================================================================
# CryptPad Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env on your server and update the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the live .env file containing your production domains
# and secrets to version control.
# ==============================================================================

# CryptPad Release Version (Pinned from the VERSION file)
CPAD_VERSION=2026.5.1

# Domain Configuration (CryptPad requires TWO domains for security sandboxing)
# Main Domain: Used for login, registration, and cryptographic key operations
CPAD_MAIN_DOMAIN=cryptpad.example.com

# Sandbox Domain: Used for rendering untrusted user documents in strict iframes
CPAD_SANDBOX_DOMAIN=cryptpad-sandbox.example.com

# Server Binding and Ports
CPAD_HTTP_PORT=3000
CPAD_HTTP_ADDRESS=0.0.0.0

# WebSocket Port (CryptPad handles active real-time collaboration)
CPAD_WEBSOCKET_PORT=3003

# Automatically Install and Update CryptPad-vetted OnlyOffice Builds
# When true, the container automatically runs CryptPad's install-onlyoffice.sh on boot
CPAD_INSTALL_ONLYOFFICE=true

# Timezone
TZ=UTC

# Admin Contact Email (Displayed on support/contact page if configured)
CPAD_ADMIN_EMAIL=admin@example.com
